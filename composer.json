{
    "name": "govorun/skeleton",
    "description": "Skeleton application for the Govorun bot framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "govorun/framework": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "App\\Support\\ComposerScripts::postCreateProject"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
